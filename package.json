{
  "name": "worship-presenter",
  "version": "1.0.0",
  "description": "Worship Presenter \u2014 live worship projection software for RCCG Youth Province 9 (Peculiar Voices). Works online and offline; updates itself.",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "electron .",
    "test": "node --test test/*.test.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always",
    "test:desktop": "xvfb-run -a node test/e2e/desktop.e2e.js"
  },
  "keywords": [],
  "author": {
    "name": "Tecxolution",
    "email": "oluyemiopeyemi726@gmail.com"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "p-limit": "^7.3.3",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "electron": "^41.10.7",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.1",
    "socket.io-client": "^4.8.4"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/OLUYEMIOPEYEMI7/Tecxolution-presenter",
  "repository": {
    "type": "git",
    "url": "https://github.com/OLUYEMIOPEYEMI7/Tecxolution-presenter.git"
  },
  "build": {
    "appId": "com.tecxolution.worshippresenter",
    "productName": "Worship Presenter",
    "copyright": "Tecxolution",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "desktop/**",
      "lib/**",
      "views/**",
      "public/**",
      "data/**",
      "server.js",
      "package.json",
      "!**/*.map",
      "!public/images/media-library/**",
      "!public/images/custom-themes/**",
      "!data/media.json",
      "!data/schedule.json",
      "!data/free-texts.json",
      "!data/state.json",
      "!data/songs.json",
      "!data/announcements.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Worship Presenter",
      "runAfterFinish": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "OLUYEMIOPEYEMI7",
        "repo": "Tecxolution-presenter",
        "releaseType": "release"
      }
    ]
  }
}
